# Front end settings (Vite). All optional: the same choices can be made at run time in the "Data source" panel.
VITE_USE_API=false                # true = start on the back end instead of the browser demo store
VITE_API_BASE_URL=/api            # where the back end is (Vite proxies /api in development)
VITE_PROXY_TARGET=http://localhost:8080
VITE_SHOW_DATA_SOURCE=false       # production builds hide the Data source chip unless this is true (it always shows in `npm run dev`)
VITE_DEFAULT_COMMUNITY=la-paloma
VITE_SCAN_URL=                    # optional virus-scan service for uploads
