# Copy to .env next to docker-compose.yml (docker compose reads it), or export these in your shell / secret manager. NEVER commit real secrets.
# Everything has a development default: set only what you change. What each setting does: docs/REDESIGN.md section 11 and
# backend/api/src/main/resources/application.yml (every COS_* variable, with its default).

# --- profile -------------------------------------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev                 # dev (simulated payments, codes in the log, demo data) | prod (refuses every simulation)

# --- database (three roles: the owner runs migrations; the API connects as cos_app and cos_platform) ----------------------
COS_DB_OWNER_PASSWORD=
COS_DB_APP_PASSWORD=
COS_DB_PLATFORM_PASSWORD=

# --- sign-in -------------------------------------------------------------------------------------------------------------
COS_JWT_SIGNING_KEY=                       # prod: required (base64, 32+ bytes); dev: a throw-away key

# --- payments --------------------------------------------------------------------------------------------------------------
COS_RAZORPAY_ENABLED=false
COS_RAZORPAY_KEY_ID=
COS_RAZORPAY_KEY_SECRET=
COS_RAZORPAY_WEBHOOK_SECRET=

# --- not passed by docker-compose.yml: add them to the api service's environment when you use them (an empty value there
#     would override the dev profile's own setting) --------------------------------------------------------------------------
# COS_OTP_PEPPER                prod: required
# COS_SMS_ENDPOINT / COS_SMS_API_KEY / COS_SMS_TEMPLATE / COS_SMS_SENDER     an HTTP SMS provider for the codes (dev: the API log)
# COS_PUSH_PROVIDER             webpush | log | none (dev: webpush with a key pair made at start-up)
# COS_PUSH_VAPID_PUBLIC_KEY / COS_PUSH_VAPID_PRIVATE_KEY / COS_PUSH_SUBJECT   base64url; the dev log prints a pair to copy

# --- the first community (the one-shot seed step) --------------------------------------------------------------------------
SEED_COMMUNITY_SLUG=la-paloma
SEED_COMMUNITY_NAME=La Paloma
SEED_ADMIN_PHONE=+919800000000
SEED_ADMIN_NAME=Super Admin
SEED_VILLAS=212

# --- on a server (docker-compose.prod.yml, docs/DEPLOY-LIGHTSAIL.md) ----------------------------------------------------------
# COS_DOMAIN=portal.example.in               the name residents open; its DNS A record points at the server (Caddy gets the certificate)
# SPRING_PROFILES_ACTIVE=prod                prod for real use; dev only for a trial behind Caddyfile.trial
# CADDYFILE=Caddyfile.trial                  a trial: the whole site behind one login (TRIAL_USER, TRIAL_HASH - in single quotes:
# TRIAL_USER=trial                           docker run --rm caddy:2.8 caddy hash-password --plaintext 'the password')
# TRIAL_HASH='$2a$14$...'
# COS_OTP_PEPPER=                            prod: 32+ random characters (openssl rand -hex 32); never change it once in use
# COS_SMS_ENDPOINT= COS_SMS_API_KEY= COS_SMS_TEMPLATE= COS_SMS_SENDER=      prod: the SMS provider that sends the sign-in codes
# COS_PUSH_VAPID_PUBLIC_KEY= COS_PUSH_VAPID_PRIVATE_KEY= COS_PUSH_SUBJECT=mailto:you@example.in   prod: Web Push keys
#                                            (docker run --rm node:22-alpine npx -y web-push generate-vapid-keys)
# BACKUP_BUCKET=                             tools/backup.sh also copies each backup to this S3 / Lightsail bucket
