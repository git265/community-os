# Copy to .env (docker compose reads it) or export these in your shell / secret manager. NEVER commit real secrets.
# Everything has a safe development default - set only what you change. Full list with explanations: docs/INTEGRATIONS.md

# --- database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/communityos
DB_USER=communityos
DB_PASSWORD=
STORAGE_PROVIDER=postgres            # postgres | memory

# --- files ------------------------------------------------------------------
FILES_PROVIDER=local                 # local | s3
FILES_LOCAL_DIR=./data/files
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=                         # blank = AWS; MinIO/R2/Spaces: their URL
S3_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- e-mail / SMS / WhatsApp ---------------------------------------------------
EMAIL_PROVIDER=log                   # log | smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=log                     # log | http
SMS_URL=
SMS_AUTH_HEADER=                     # e.g. "Bearer abc" or "Basic ..."
WHATSAPP_PROVIDER=log
WHATSAPP_URL=
WHATSAPP_AUTH_HEADER=
OUTBOX_ENABLED=false                 # true on the ONE instance that sends

# --- payments / GST -------------------------------------------------------------
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=change-me
PAYMENT_TRUST_CLIENT_AMOUNT=true     # false in production (price from app.payments.pricing)
GST_PROVIDER=simulated

# --- security -------------------------------------------------------------------
SECURITY_MODE=none                   # none | api-key | jwt
API_KEY=
JWT_ISSUER_URI=
JWT_TENANT_CLAIM=community
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ALLOW_TENANT_RESET=false
