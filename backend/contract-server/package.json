{
  "name": "communityos-contract-server",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Reference implementation of the CommunityOS REST contract on PostgreSQL, for trying the UI without Java. NOT for production: use backend/spring.",
  "scripts": { "start": "node server.mjs", "test": "node --test test/api.test.mjs test/payments.test.mjs test/hardening.test.mjs test/scope.test.mjs test/evoting.test.mjs test/platform.test.mjs",
    "gen:rulebook": "node --import ./register-hooks.mjs test/gen-rulebook-golden.mjs",
    "gen:moneyguard": "node --import ./register-hooks.mjs test/gen-moneyguard-golden.mjs",
    "gen:evoting": "node --import ./register-hooks.mjs test/gen-evoting-golden.mjs", "gen:amenity": "TZ=Asia/Kolkata node --import ./register-hooks.mjs test/gen-amenity-golden.mjs",
    "gen:fieldcrypto": "node test/gen-fieldcrypto-golden.mjs",
    "gen:amenity-notify": "TZ=Asia/Kolkata node --import ./register-hooks.mjs test/gen-amenity-notify-golden.mjs",
    "gen:jobs": "TZ=Asia/Kolkata node --import ./register-hooks.mjs test/gen-jobs-golden.mjs",
    "gen:people": "TZ=Asia/Kolkata node --import ./register-hooks.mjs test/gen-people-golden.mjs",
    "gen:new-community": "node --import ./register-hooks.mjs test/gen-new-community.mjs" },
  "dependencies": { "pg": "^8.11.0" }
}
